# ============================================================
# Application
# ============================================================
APP_NAME=YouCode AI Platform
APP_ENV=development
APP_DEBUG=true

# ============================================================
# LiteLLM Proxy — all LLM requests go through here
# ============================================================
CHAT_PROVIDER=litellm
LITELLM_CHAT_MODEL=gemini-3.5-flash-lite
LITELLM_EMBEDDING_MODEL=text-embedding-004

# Google API Key — used by LiteLLM to call Gemini
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================
# RabbitMQ
# ============================================================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ============================================================
# LangGraph / LangChain
# ============================================================
LANGGRAPH_CHECKPOINT_PATH=data/langgraph_checkpoints.sqlite
MAX_HISTORY_MESSAGES=20

# LangSmith Monitoring (Optional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=youcode-ai-agent

# ============================================================
# Databases
# ============================================================
# Docker (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://youcode:youcode_pass@postgres:5432/youcode_api

# Local dev (SQLite)
# DATABASE_URL=sqlite:///data/youcode.db

# ============================================================
# Qdrant — Vector Store
# ============================================================
# Docker
QDRANT_URL=http://qdrant:6333
# Local dev
# QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_DOCUMENTS_COLLECTION=youcode_documents_gemini
QDRANT_KNOWLEDGE_GAPS_COLLECTION=youcode_knowledge_gaps_gemini
RAG_INGESTION_BATCH_SIZE=50

# ============================================================
# RAG — Retrieval Settings
# ============================================================
DOCUMENTS_PATH=data/documents
PARENT_STORE_PATH=data/parent_store/parents.json
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.55
RAG_PARENT_CHUNK_SIZE=1000
RAG_PARENT_CHUNK_OVERLAP=200
RAG_CHILD_CHUNK_SIZE=200
RAG_CHILD_CHUNK_OVERLAP=50

# ============================================================
# Memory Summarizer
# ============================================================
MEMORY_SUMMARY_THRESHOLD=30
MEMORY_KEEP_RECENT=10

# ============================================================
# External Services
# ============================================================
REGISTRATION_API_URL=http://fake-registration-api:9001
REGISTRATION_API_KEY=
TEST_SESSION_API_URL=http://127.0.0.1:9002
EMAIL_API_URL=http://127.0.0.1:9003
EXTERNAL_API_TIMEOUT=10

# MCP Servers
EMAIL_MCP_URL=http://email-mcp:8005
SHEET_MCP_URL=http://sheet-gmcp:8004

# ============================================================
# Admin Notifications
# ============================================================
ADMIN_EMAIL=admin@youcode.ma

# ============================================================
# Discord Gateway
# ============================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Comma-separated list of channel IDs the bot listens to


# ============================================================
# WhatsApp / Evolution API
# ============================================================
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=super_secret_key
WEBHOOK_SECRET=

# ============================================================
# Google Sheets (Sheet GMCP)
# ============================================================
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================
# Consent
# ============================================================
CONSENT_VERSION=2026-01
CONSENT_SECRET_KEY=replace-this-with-a-secure-random-secret-key
CONSENT_TOKEN_TTL_MINUTES=30

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ============================================================
# Email / SMTP
# ============================================================
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@youcode.ma
EMAIL_FROM_NAME=YouCode
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
EMAIL_MAX_ATTEMPTS=3

# ============================================================
# Auth
# ============================================================
AUTH_SECRET_KEY=replace-with-a-secure-random-key-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ============================================================
# Notes for Docker deployment
# ============================================================
# When running with Docker Compose, the following env vars are
# automatically overridden by compose.yaml:
#   - QDRANT_URL        → http://qdrant:6333
#   - DATABASE_URL      → postgresql+asyncpg://...@postgres:5432/...
#   - LITELLM_URL       → http://litellm:4000
#   - RABBITMQ_URL      → amqp://guest:guest@rabbitmq:5672/
#   - EMAIL_MCP_URL     → http://email-mcp:8005
#   - SHEET_MCP_URL     → http://sheet-gmcp:8004
