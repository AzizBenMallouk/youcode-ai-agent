
# Application
APP_NAME=YouCode AI Platform
APP_ENV=development
APP_DEBUG=true

# Providers
CHAT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Gemini
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# LangGraph / LangChain
LANGGRAPH_CHECKPOINT_PATH=data/langgraph_checkpoints.sqlite

# LangSmith Monitoring (Optional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=youcode-ai-agent

# SQL database
DATABASE_URL=postgresql+psycopg://youcode:youcode@postgres:5432/youcode_db

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_DOCUMENTS_COLLECTION=youcode_documents_ollama
QDRANT_KNOWLEDGE_GAPS_COLLECTION=youcode_knowledge_gaps_ollama
RAG_INGESTION_BATCH_SIZE=50

# RAG
DOCUMENTS_PATH=data/documents
PARENT_STORE_PATH=data/parent_store/parents.json
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.55
RAG_PARENT_CHUNK_SIZE=1200
RAG_PARENT_CHUNK_OVERLAP=150
RAG_CHILD_CHUNK_SIZE=300
RAG_CHILD_CHUNK_OVERLAP=50

# External services
REGISTRATION_API_URL=http://127.0.0.1:9001
REGISTRATION_API_KEY=
TEST_SESSION_API_URL=http://127.0.0.1:9002
EMAIL_API_URL=http://127.0.0.1:9003
EXTERNAL_API_TIMEOUT=10

# Conversation
MAX_HISTORY_MESSAGES=12

# Consent
CONSENT_VERSION=2026-01
CONSENT_SECRET_KEY=replace-this-with-a-secure-random-secret-key
CONSENT_TOKEN_TTL_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Email
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@youcode.ma
EMAIL_FROM_NAME=YouCode
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
EMAIL_MAX_ATTEMPTS=3

# Authentication
AUTH_SECRET_KEY=replace-with-a-secure-random-key-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=


# ==========================================
# DOCKER CONFIGURATION
# ==========================================
# If using Docker, you do NOT need to change QDRANT_URL or FASTAPI_URL manually.
# The compose.yaml file automatically overrides them.
# However, if you are using OLLAMA on your host machine while running Docker,
# you must use this specific URL to access the host:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
